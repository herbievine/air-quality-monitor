# Copy to .env and adjust if needed. All have sane defaults baked into
# app/config.py, so an empty .env (or none at all) also works.

# Serial device for the PMS5003, after adding dtoverlay=uart0-pi5 (see SETUP.md)
PMS5003_SERIAL_PORT=/dev/ttyAMA0

# How often to read SCD-41 + PMS5003, write to SQLite, and publish to MQTT
POLL_INTERVAL_SECONDS=30

# MQTT broker - defaults to the bundled mosquitto service
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_STATE_TOPIC=airmonitor/state
MQTT_DISCOVERY_PREFIX=homeassistant

SQLITE_PATH=/app/data/air_quality.db
